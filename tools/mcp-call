#!/usr/bin/env python3
"""mcp-call —— 调用 CasioEmuMsvc 的 McpPlugin（MCP over HTTP，默认 127.0.0.1:3001）。

    tools/mcp-call tools                       # 列出工具
    tools/mcp-call call get_status
    tools/mcp-call call write_memory '{"address":"0xE9E0","bytes":[1,2,3]}'
    tools/mcp-call call read_memory  '{"address":"0xD31C","size":2}'
    tools/mcp-call call keyboard_key '{"ki":3,"ko":7,"pressed":true}'
    tools/mcp-call call keyboard_key '{"ki":3,"ko":7,"pressed":false}'

只依赖标准库；`address`/`size` 接受 `0x` 前缀字符串或整数。
"""

from __future__ import annotations

import json
import sys
import urllib.request

HOST = "127.0.0.1"
PORT = 3001


def rpc(payload: dict) -> dict:
    req = urllib.request.Request(
        "http://%s:%d/mcp" % (HOST, PORT),
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json",
                 "Accept": "application/json, text/event-stream"})
    with urllib.request.urlopen(req, timeout=20) as fh:
        body = fh.read().decode()
    # 有些实现回 SSE 帧，取最后一行 data:
    if body.lstrip().startswith("event:") or body.lstrip().startswith("data:"):
        for line in body.splitlines():
            if line.startswith("data:"):
                body = line[5:].strip()
    return json.loads(body)


def coerce(args: dict) -> dict:
    out = {}
    for k, v in args.items():
        if isinstance(v, str) and v.lower().startswith("0x"):
            out[k] = int(v, 16)
        else:
            out[k] = v
    return out


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    cmd = sys.argv[1]
    if cmd == "tools":
        d = rpc({"jsonrpc": "2.0", "id": 1, "method": "tools/list"})
        for t in d["result"]["tools"]:
            print("%-24s %s" % (t["name"], t.get("description", "")[:70]))
        return 0
    if cmd == "call" and len(sys.argv) >= 3:
        name = sys.argv[2]
        args = coerce(json.loads(sys.argv[3])) if len(sys.argv) > 3 else {}
        d = rpc({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
                 "params": {"name": name, "arguments": args}})
        res = d.get("result", d)
        if isinstance(res, dict) and "content" in res:
            for c in res["content"]:
                print(c.get("text", ""))
        else:
            print(json.dumps(res, ensure_ascii=False)[:4000])
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
